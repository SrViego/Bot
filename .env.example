DISCORD_TOKEN=cole_o_token_do_bot_aqui

# Opcional — canais de boas-vindas / despedida
WELCOME_CHANNEL_ID=
GOODBYE_CHANNEL_ID=
# WELCOME_GIF_URL=
# GOODBYE_GIF_URL=

# Lavalink (no Docker o compose usa host interno "lavalink")
# Troque a senha se a porta for acessível fora da rede Docker
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=troque_essa_senha
LAVALINK_SECURE=false
LAVALINK_SEARCH_SOURCE=ytsearch
LAVALINK_SEARCH_FALLBACKS=ytsearch,ytmsearch,scsearch
LAVALINK_DEFAULT_VOLUME=80

# Canais exclusivos (obrigatórios para esses sistemas)
POKEMON_CHANNEL_ID=
BAKERY_CHANNEL_ID=

# Métricas / backup (opcional)
# METRICS_RETENTION_DAYS=14
# DATA_BACKUP_KEEP=14

# Persistência: json (default) | sqlite
# Após migrar: node scripts/migrate-json-to-sqlite.js
DATA_BACKEND=json
