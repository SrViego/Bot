# Lavalink com plugins já no image (evita download em volume sem permissão)
# Versões: Lavalink 4.2.2 · youtube-plugin 1.18.2 · LavaSrc 4.8.3 (releases mais recentes em 2026-10)
FROM ghcr.io/lavalink-devs/lavalink:4.2.2

ARG YOUTUBE_PLUGIN_VERSION=1.18.2
ARG LAVASRC_VERSION=4.8.3

USER root
RUN mkdir -p /opt/Lavalink/plugins
ADD https://maven.lavalink.dev/releases/dev/lavalink/youtube/youtube-plugin/${YOUTUBE_PLUGIN_VERSION}/youtube-plugin-${YOUTUBE_PLUGIN_VERSION}.jar \
    /opt/Lavalink/plugins/youtube-plugin-${YOUTUBE_PLUGIN_VERSION}.jar
ADD https://maven.lavalink.dev/releases/com/github/topi314/lavasrc/lavasrc-plugin/${LAVASRC_VERSION}/lavasrc-plugin-${LAVASRC_VERSION}.jar \
    /opt/Lavalink/plugins/lavasrc-plugin-${LAVASRC_VERSION}.jar
RUN chown -R lavalink:lavalink /opt/Lavalink/plugins \
 && chmod 644 /opt/Lavalink/plugins/*.jar

USER lavalink
WORKDIR /opt/Lavalink
